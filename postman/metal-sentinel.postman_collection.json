{
  "info": {
    "_postman_id": "c45bbb2a-c7ce-4f11-8c7a-565446f8e7cc",
    "name": "Metal Sentinel API",
    "description": "Live spot quotes for ten metals refreshed every 15 seconds, daily historical series, gold karat and silver fineness prices, crypto and forex quotes, market status and mining equities. Subscribe on RapidAPI to get an API key; the free plan includes 7,500 requests per month.\n\nDocs: https://metal-sentinel.com/endpoints\nGet a key: https://rapidapi.com/ghostsvos/api/metal-sentinel\n\nSet the `rapidapi_key` collection variable to your RapidAPI key.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Spot prices",
      "description": "Current quotes for metals, gold karats and silver fineness.",
      "item": [
        {
          "name": "Current spot price for one metal in one currency",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-rapidapi-key",
                "value": "{{rapidapi_key}}",
                "type": "text"
              },
              {
                "key": "x-rapidapi-host",
                "value": "metal-sentinel.p.rapidapi.com",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/metal-quote?symbol=AU&currency=USD",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "metal-quote"
              ],
              "query": [
                {
                  "key": "symbol",
                  "value": "AU",
                  "disabled": false,
                  "description": "Metal symbol."
                },
                {
                  "key": "currency",
                  "value": "USD",
                  "disabled": false,
                  "description": "ISO 4217 fiat code or supported crypto token. See /api/allowed-currencies."
                },
                {
                  "key": "timestamp",
                  "value": "1760000000",
                  "disabled": true,
                  "description": "Unix timestamp (seconds) for a historical quote. Omit for the latest quote."
                }
              ]
            },
            "description": "Current spot price for one metal in one currency"
          },
          "response": []
        },
